#!/bin/bash
#******************************************************************************
#
# * File: cfgload
#
# * Author:  Umut Sevdi
# * Created: 08/20/22
# * Description: A script that updates the configuration files. Changes 
# GNOME settings to sane defaults.
#*****************************************************************************

CFGDIR=`dirname $(which cfgload)`
Help()
{
   # Display Help
   echo "cfgload"
   echo "  Update configuration files"
   echo
   echo "Syntax: [-r]"
   echo
   echo "Options:"
   echo "-h/--help      Prints this menu."
}

GsettingsSet()
{
    gsettings set org.gnome.software allow-updates                    false
    gsettings set org.gnome.desktop.interface show-battery-percentage true
    gsettings set org.gnome.shell always-show-log-out                 true
    gsettings set org.gnome.desktop.interface document-font-name      'Adwaita Sans 9.5'
    gsettings set org.gnome.desktop.interface font-name               'Adwaita Sans 9.5'
    gsettings set org.gnome.desktop.wm.preferences titlebar-font      'Adwaita Sans Bold 10'
    gsettings set org.gnome.desktop.interface monospace-font-name     'CommitMonoNerdFont Regular 9.5'
}

Unpack()
{
    mkdir -p ~/.local/bin
    mkdir -p ~/.config/tmux
    mkdir -p ~/.config/nvim
    cp -r ${CFGDIR}/../tmux.conf ~/.config/tmux/tmux.conf
    cp -r ${CFGDIR}/../nvim/init.lua $HOME/.config/nvim/
    cp -r ${CFGDIR}/../bashrc $HOME/.bashrc
}

CleanOne()
{
    if [ -f $1 ] || [ -d $1 ]; then
        rm $1 -fr && echo "Cleaning $1"
    fi 
}

Clean()
{
    files=(
            .ai
            .cmake
            .java
            .node_repl_history
            .npm
            .nuget
            .python_history
            .rumdl_cache
            .viminfo
            .w3m
            .yarn
            .yarnrc
    )
    for file in "${files[@]}"; do
        if [ -f "$HOME/$file" ] || [ -d "$HOME/$file" ]; then
            rm $HOME/$file -fr && echo "Cleaning $HOME/$file"
        fi 
    done
}

for arg in $@;do
    if   [ $arg = -h ] || [ $arg = --help ]; then
        Help
        exit
    else
        echo -e "Error: Invalid arguments" 1>&2
        exit
    fi 
done
Unpack
Clean
GsettingsSet
source $HOME/.bashrc
colorscheme -r
